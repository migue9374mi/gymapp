# ==========================================
# Variables de entorno del backend
# Copia este archivo como .env y rellena los valores
# ==========================================

PORT=5000

# --- Seguridad (OBLIGATORIO cambiar en produccion) ---
# Genera una larga con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# --- Base de datos ---
# NO definas esto para trabajar en local: se usa database.db automaticamente.
# En la nube (Turso) pega aqui la URL que te dan al crear la base de datos.
# TURSO_DATABASE_URL=https://tu-base.turso.io
# TURSO_AUTH_TOKEN=tu_token

# --- Fotos ---
# NO definas esto para trabajar en local: se guardan en backend/uploads.
# En la nube (Cloudinary) pega aqui los datos de tu cuenta.
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=tu_api_secret

# --- Recuperar contrasena (manda el enlace por correo) ---
# Sin esto la app funciona igual, pero la recuperacion no envia el correo.
#
# Con una cuenta de Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tu-correo@gmail.com
#   SMTP_PASS=una "contrasena de aplicacion" de Google, NO tu contraseña
#   (se crea en la cuenta de Google: seguridad > verificacion en 2 pasos >
#    contrasenas de aplicacion)
#
# Con otros servicios (Brevo, Resend, Mailgun...) cambias estos cuatro
# valores y ya esta, el codigo no cambia.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Email remitente. Si no lo pones, se usa SMTP_USER.
# EMAIL_REMITENTE=

# --- Frontend permitido (CORS) ---
# En produccion pon aqui la URL de tu frontend en Vercel.
#
# Si ademas usas la app de Android (Capacitor), hay que permitir tambien su
# origen. La app no es un navegador: se identifica como "https://localhost",
# y sin esta entrada el backend rechaza todas sus peticiones.
#
# Varios dominios separados por coma.
# FRONTEND_URL=https://tu-app.vercel.app,https://localhost
#
# Origenes que usa la app de Android:
#   https://localhost   -> capacitor con esquema https (el que usa el proyecto)
#   capacitor://localhost -> esquema por defecto en iOS
#   http://localhost      -> esquema http, por si se cambia el config